}
_SENT_IDX_CACHE = {"ts": 0.0, "closes": None, "vols": None, "diag": ""}  # 指数收盘+成交量缓存（60s）
_SENT_TS = {}            # code -> (ts, dict) 情绪评估结果短缓存（2s，防同bar重复取数）
_SENT_EWMA = {}          # code -> EWMA 平滑后的复合情绪分（内存态，重启重建）
