    return False


def data_gate_ready_for(C, code, popup=None):
    """逐标的数据就绪闸门（AUD56，2026-10-13，用户拍板 P2 方案A）。

    与全局版 data_gate_ready 的区别：只查「沪深300指数（F2 共用）+ 当前这一只标的」
    的日线是否足量。别的标的数据没补齐，不再连累本标的被拦——谁缺数据只拦谁。
