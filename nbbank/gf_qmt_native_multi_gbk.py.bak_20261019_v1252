        return "无持仓，无卖出动作"

    # 1) 止盈状态
    if tp_ok:
        _seg.append("止盈信号成立(%s)" % (tp_reason or "无"))
    else:
        _seg.append("止盈信号未成立")

    # 2) 止损告警（仅告警，红线不卖）
    if sl_ok and sl_alert:
        _seg.append("止损告警(净回撤%.2f%%/浮亏%.2f%%)→铁律仅告警不卖出" % (
            sl_alert.get("drawdown_pct", 0.0) * 100.0, sl_alert.get("loss_pct", 0.0) * 100.0))
    else:
        _seg.append("止损告警未触发(仍不自动卖出)")

