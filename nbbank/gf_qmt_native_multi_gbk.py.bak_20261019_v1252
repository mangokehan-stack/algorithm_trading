                os.remove(DATA_GATE_ALERT_FILE)
                _mirror_remove("data_gate_alert.json")   # AUD38：镜像同步删除告警标志
        except Exception:
            pass
        g["ok"], g["ts"], g["items"] = True, now, []
        return True
    g["ok"], g["ts"], g["items"] = False, now, items
    for name, use, diag in items:
